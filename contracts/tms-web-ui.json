      "--aw-switch-handle": "#FFF",
      "--aw-text-3": "rgb(255 255 255 / 60%)",
      "--aw-text-4": "rgb(255 255 255 / 52%)",
        "--aw-fill-1": "#1B1F27",
        "--aw-fill-2": "#21262F",
        "--aw-fill-3": "#2A2F38",
        "--aw-fill-4": "#171A20"
      }
    },
    "antdAliasMappings": {
      "colorFill": "--aw-fill-3",
      "colorFillSecondary": "--aw-fill-2",
      "colorFillTertiary": "--aw-fill-1",
      "colorFillQuaternary": "--aw-fill-4"
    },
    "antdComponentMappings": {
      "Button.colorPrimary": "--aw-primary-solid",
      "Button.colorPrimaryHover": "--aw-primary-solid-hover",
      "Button.colorPrimaryActive": "--aw-primary-solid-active",
      "Button.colorError": "--aw-danger-solid",
      "Button.colorErrorHover": "--aw-danger-solid-hover"
    },
    "consumerExtensions": {
      "allowed": true,
      "rule": "Application-private tokens must be explicitly namespaced or documented and must not redefine source token names. Cross-module semantic tokens are promoted source-first."
    }
  },
  "breakpoints": {
    "strategy": "desktop-first-with-narrow-screen-support",
    "canonical": {
      "xs": 480,
      "sm": 576,
      "md": 768,
      "lg": 992,
      "xl": 1200,
      "xxl": 1600
    },
    "qaTargetWidths": [390, 480, 576, 768, 1024, 1280, 1366, 1440, 1920],
    "narrowScreen": {
      "supported": true,
      "resolutionGuard": false,
      "navigation": "mobile-tab-bar-below-md",
      "table": "preserve-primary-columns-and-use-horizontal-scroll"
    }
  },
  "density": {
    "smallControlHeight": 24,
    "compactControlHeight": 28,
    "defaultControlHeight": 32,
    "largeControlHeight": 40,
    "compactRule": "Compact is an application density and must not be implemented by Ant Design compactAlgorithm."
  },
  "pagination": {
    "defaultPageSize": 20,
    "pageSizeOptions": [20, 50, 100, 200]
  },
  "i18n": {
    "locales": ["zh_CN", "en", "es", "pt", "fr", "ru"],
    "requiredAllLocaleKeys": ["common.scrollableTable", "common.dangerZone", "common.moreFor", "common.actionProcessing"],
    "defaultValueLiteralRequiredLocales": ["zh_CN", "en"]
  },
  "dateTime": {
    "transport": "RFC3339-or-ISO-8601-instant",
    "displayApi": "Intl.DateTimeFormat",
    "timeZonePriority": ["user-or-tenant-iana", "runtime-resolved-iana", "UTC"],
    "fixedOffsetAsZoneAllowed": false
  },
  "visualPresentation": {
    "table": {
      "defaultAlign": "left",
      "numberAlign": "left",
      "dateTimeAlign": "left",
      "actionsAlign": "left",
      "amountAlign": "right",
      "cellPaddingInline": 16,
      "numericFontVariant": "tabular-nums"
    },
    "controls": {
      "buttonWhiteSpace": "nowrap",
      "buttonFlexShrink": 0,
      "singleSelectValueOverflow": "ellipsis",
      "switchHandleAlignment": "center"
    },
    "icons": {
      "documentationSvgViewBox": [0, 0, 24, 24],
      "documentationSvgStrokeWidth": 1.5,
      "consumerSource": "antd-exports-or-reviewed-local-svg"
    },
    "staticStatusMatrixAnimation": false,
    "decorativeTreeNodeIcons": false,
    "preserveLoadingAndInteractiveIndicators": true
  },
  "rowActions": {
    "table": {
      "visiblePrimaryCount": 1,
      "maxVisibleCount": 3,
      "visibleEntryLimit": 3,
      "moreCountsAsEntry": true,
      "overflowInlineLimit": 2,
      "collapseFrom": 4,
      "inlinePresentation": "text-only",
      "menuPresentation": "text-only",
      "minimumVisibleCount": 1,
      "collapseOnlyFor": "count-danger-or-insufficient-width"
    },
    "compactCard": {
      "maxVisibleCount": 2,
      "collapseFrom": 3
    },
    "toolbar": {
      "maxVisibleCount": 3,
      "collapseFrom": 4,
      "inlinePresentation": "text-only",
      "menuPresentation": "text-only"
    },
    "placement": ["primary", "secondary", "menu"],
    "responsive": {
      "structuralBreakpoint": "md",
      "fit": "measured-action-width",
      "preservePrimaryAction": true,
      "minimumFitFallback": "grow-column-unpin-local-scroll"
    },
    "singleSafeActionInline": true,
    "dangerInlineDefault": false,
    "dangerInlineExceptions": ["group-membership-removal"],
    "confirmation": "single-modal-independent-of-placement",
    "menuKeyboardFocus": true,
    "pendingPreventsRepeat": true,
    "dangerLast": true,
    "dangerConfirmationDefaultFocus": "cancel"
  },
  "pageHeader": {
    "backNavigation": {
      "presentation": "arrow-left-and-text",
      "requiredFor": ["nested-detail", "form", "immersive-flow"],
      "hiddenFor": ["top-level-list", "top-level-dashboard"],
      "detailBreadcrumbsAllowed": true,
      "formBreadcrumbsAllowed": false,
      "immersiveBreadcrumbsAllowed": false,
      "targetPriority": ["explicit-target", "validated-in-app-source", "business-parent"],
      "externalHistoryFallbackAllowed": false,
      "preserveListState": true,
      "preserveUnsavedChangesGuard": true,
      "placement": "content",
      "detailPlacement": "before-title-same-row",
      "outsideHeading": true,
      "visibleWhenSticky": true,
      "visibleWhenMobile": true,
      "visibleDuring": ["loading", "empty", "error", "forbidden"]
    },
    "freeTextSubtitle": false,
    "keyFieldsOnly": true,
    "maxPrimaryActions": 1,
    "dangerActionsAllowed": false,
    "dangerActionsPlacement": ["separated-overflow-menu", "danger-zone"],
    "collapseActionsFrom": 4,
    "longPageSticky": ["detail", "form", "dashboard"],
    "listPageSticky": false,
    "compactAfterScrollPx": 60
  },
  "feedback": {
    "providerOrder": ["ConfigProvider", "App"],
    "api": "App.useApp()",
    "staticApiAllowed": false,
    "notification": {
      "placement": "topRight",
      "maxCount": 3
    },
    "failurePresentation": {
      "initialOrRefreshLoad": {
        "toastOnlyAllowed": false,
        "persistentInlineComponents": ["Alert", "Result"],
        "retryRequired": true
      },
      "singleOperationOnPresentedContent": {
        "messageAllowed": true
      }
    }
  },
  "decisionRecords": ["docs/decisions/specs/2026-10-21-detail-return-header-alignment.md", "docs/decisions/specs/2026-10-21-aw-table.md"],
  "awTable": {
    "name": "AWTable",
    "specification": "docs/components/aw-table.md",
    "interactionSpecification": "docs/components/aw-table-interactions.md",
    "consumerReuseEvidence": "docs/decisions/audits/2026-10-21-awtable-consumer-reuse.md",
    "delivery": {
      "source": "specification-and-interactive-demo",
      "consumer": "approved-app-install-tasks-and-ota-workspace-implementation",
      "publishedRuntimePackage": false
    },
    "engine": "antd-native-table",
    "dataModes": ["remote", "local"],
    "composition": ["filters", "toolbar", "selection-bar", "table", "pagination", "state-view"],
    "columnSettings": {
      "enabled": "opt-in-visibility-only",
      "api": ["schemaVersion", "scopeKey"],
      "entry": "fixed-actions-header-otherwise-required-identity-header",
      "fallbackWithoutIdentity": "first-business-column-header",
      "standaloneToolbar": false,
      "addsHeaderRow": false,
      "headerSortTarget": "independent",
      "requiredColumns": ["first-identity-or-first-business", "actions"],
      "identityHideableDefault": false,
      "columnOverride": "hideable",
      "defaultVisibility": "all-columns",
      "commit": "apply-draft-once",
      "cancel": "discard-draft-on-cancel-escape-outside",
      "reset": "all-columns-in-draft-until-apply",
      "queryEffect": "none",
      "storage": "local",
      "storagePayload": ["schemaVersion", "hiddenIds"],
      "storageScope": ["application", "user", "tenant", "tableId", "schemaVersion"],
      "newColumns": "visible",
      "legacyOtaCache": "ignored",
      "contextChange": "close-and-discard-draft-preserve-same-identity-preferences",
      "dragReorder": "deferred",
      "resize": "deferred"
    },
    "standaloneRefreshControl": false,
    "filters": {
      "name": "AWTableFilters",
      "standalone": true,
      "referencePattern": "resource-package-panel",
      "structure": ["primary-fields", "advanced-fields", "divider", "expand-left-applied-count-reset-submit-right"],
      "visibleTitle": false,
      "accessibleName": "localized-title",
      "activeCountPlacement": "footer-before-reset",
      "zeroCountVisible": true,
      "fields": "caller-schema",
      "defaultSubmitMode": "explicit",
      "draftSeparateFromApplied": true,
      "activeCountSource": "normalized-applied",
      "rangeCountsAs": 1,
      "zeroAndFalseAreValues": true,
      "collapsePreservesDraftAndApplied": true,
      "submitIncludesCollapsedFields": true,
      "collapseEmitsQuery": false,
      "reset": "declared-defaults-one-event-collapse-first-page",
      "sortAndPageSizeReset": "parent-declared-policy",
      "externalContextReset": false,
      "layout": "container-responsive-primary-advanced",
      "panelPadding": 16,
      "businessIcons": false,
      "optionFailure": "field-local-error-and-retry",
      "asyncValidation": "current-draft-and-context-only",
      "dateSerialization": "domain-adapter-with-explicit-timezone-and-boundary"
    },
    "rowKey": "stable-string",
    "actions": {
      "normalInlineLimit": 3,
      "collapseFrom": 4,
      "overflowInlineLimit": 2,
      "visibleEntryLimit": 3,
      "moreCountsAsEntry": true,
      "exceptions": ["danger", "insufficient-container-width"],
      "businessIcons": false,
      "preserveInteractionIndicators": true,
      "hiddenCounts": false,
      "disabledCounts": true,
      "executionLock": "context-row-action-confirming-through-execution",
      "mutationCompletion": "origin-context-current-applied-query",
      "failureFeedback": "single-owner"
    },
    "layout": {
      "cellPaddingInline": 16,
      "selectionWidth": 40,
      "densityMinRowHeights": [32, 40, 48],
      "actionWidth": "current-locale-measured-final-combinations-plus-cell-padding",
      "actionWidthScope": "table-not-row-or-page",
      "minimumPrimaryFit": "grow-column-unpin-local-scroll",
      "scrollX": "sum-visible-planned-column-widths",
      "freezeBudget": "container-minus-at-least-one-key-data-column-min-width",
      "unfreezeOrder": ["secondary-left", "actions-right", "primary-left"],
      "measurement": "content-box-without-double-subtraction",
      "measurementInvalidation": ["container", "locale", "font", "density", "definitions"],
      "virtualization": "explicit-performance-tested-native"
    },
    "paginationLayout": {
      "total": "left",
      "controls": "right",
      "narrow": "wrap-without-clipping",
      "tableAndCard": "shared-presentation-single-event-owner"
    },
    "query": {
      "event": "onQueryChange",
      "oneCommitPerInteraction": true,
      "draftSeparateFromApplied": true,
      "pageSizeChange": "first-page",
      "sortChange": "first-page",
      "filterChange": "first-page",
      "search": "always-request-once-with-validated-draft",
      "unchangedSearch": "reload-current-page",
      "searchWhilePending": "prevent-duplicate-request",
      "coordinator": "one-synchronous-admission-and-request-owner",
      "resetAtDefaultQuery": "no-read-clear-selection-and-draft",
      "refresh": "preserve-applied-query",
      "requestResult": "latest-query-only",
      "remoteDataResliced": false
    },
    "request": {
      "gate": ["ready", "waiting", "blocked"],
      "gateOwner": "domain-adapter",
      "unreadyScopeReads": false,
      "staleResultIsolation": ["success", "error", "finally"],
      "foregroundPending": "disable-query-controls-keep-draft-editable",
      "refreshPresentation": "in-table-loading-without-visible-status-row",
      "refreshAnnouncement": "screen-reader-only",
      "preserveResultLayoutWhilePending": true,
      "refreshErrorPresentation": "persistent-stale-result-warning-and-retry",
      "mutationInvalidation": "coalesce-one-read-in-origin-context",
      "errorIsolation": "per-region",
      "automaticPolling": "opt-in-external-adapter",
      "writeAutoRetry": false
    },
    "selection": {
      "defaultSelectAll": "current-page",
      "retention": ["page", "query", "context"],
      "allMatchingRequiresBackendContract": true,
      "partialFailure": "retain-failed-selection",
      "batchSnapshot": "freeze-at-confirmation-or-direct-trigger",
      "unknownOutcome": "verify-before-retry"
    },
    "preferences": {
      "scope": ["user", "tenant", "tableId", "schemaVersion"],
      "queryStorage": "url-or-session",
      "presentationStorage": "local",
      "restoreValidation": "schema-field-and-context-whitelist-before-first-read",
      "restorePendingOrDialogs": false
    },
    "accessibility": {
      "keyboardMenus": true,
      "focusReturn": true,
      "fullValueOnFocusAndTouch": true,
      "namedFocusableScrollRegion": true,
      "scrollFocusWhen": "actual-overflow",
      "focusReturnPolicy": "valid-trigger-or-neighbor-without-stealing-focus"
    },
    "companionPatterns": ["semantic-cells", "overflow-text", "organization-scope", "form-dialog", "export", "query-restoration"]
  }
}
