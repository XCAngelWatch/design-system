{
  "schemaVersion": 1,
  "contractVersion": "2026-10-21",
  "sourceRepository": "design-system",
  "consumerRepository": "tms2.5-web-ui",
  "consumerCopyPath": "docs/design-system/source-contract.json",
  "decisionRecord": "docs/decisions/specs/2026-10-21-aw-table.md",
  "tokens": {
    "sourceFile": "project/styles/tokens.css",
    "prefix": "--aw-",
    "required": [
      "--aw-primary",
      "--aw-primary-text",
      "--aw-primary-solid",
      "--aw-primary-solid-hover",
      "--aw-primary-solid-active",
      "--aw-primary-hover",
      "--aw-primary-active",
      "--aw-primary-bg",
      "--aw-primary-bg-hover",
      "--aw-primary-border",
      "--aw-success",
      "--aw-success-solid",
      "--aw-warning",
      "--aw-danger",
      "--aw-danger-hover",
      "--aw-danger-solid",
      "--aw-danger-solid-hover",
      "--aw-info",
      "--aw-text-1",
      "--aw-text-2",
      "--aw-text-3",
      "--aw-text-4",
      "--aw-text-disabled",
      "--aw-text-on-brand",
      "--aw-border-1",
      "--aw-border-2",
      "--aw-border-3",
      "--aw-fill-1",
      "--aw-fill-2",
      "--aw-fill-3",
      "--aw-fill-4",
      "--aw-switch-handle",
      "--aw-bg",
      "--aw-bg-page",
      "--aw-bg-elevated"
    ],
    "coreValues": {
      "light": {
      "--aw-primary": "#165DFF",
      "--aw-primary-text": "#165DFF",
      "--aw-primary-solid": "#165DFF",
      "--aw-primary-solid-hover": "#0E42D2",
      "--aw-primary-solid-active": "#0B36AE",
        "--aw-success": "#237804",
        "--aw-success-solid": "#237804",
        "--aw-warning": "#874D00",
        "--aw-danger": "#CF1322",
        "--aw-info": "#0958D9",
      "--aw-danger-hover": "#C8242A",
      "--aw-danger-solid": "#CF1322",
      "--aw-danger-solid-hover": "#A8071A",
      "--aw-text-on-brand": "#FFF",
      "--aw-switch-handle": "#FFF",
      "--aw-text-3": "#5F6B7A",
      "--aw-text-4": "#667085",
        "--aw-fill-1": "#FAFAFA",
        "--aw-fill-2": "#F5F5F5",
        "--aw-fill-3": "#EEEEEE",
        "--aw-fill-4": "#FCFCFC"
      },
      "dark": {
      "--aw-primary": "#4080FF",
      "--aw-primary-text": "#6AA1FF",
      "--aw-primary-solid": "#2858DC",
      "--aw-primary-solid-hover": "#3666D6",
      "--aw-primary-solid-active": "#1F49B6",
        "--aw-success": "#52C41A",
        "--aw-success-solid": "#237804",
        "--aw-warning": "#FAAD14",
        "--aw-danger": "#FF4D4F",
        "--aw-info": "#4DABF7",
      "--aw-danger-hover": "#FF7875",
      "--aw-danger-solid": "#B4232C",
      "--aw-danger-solid-hover": "#9F1D26",
